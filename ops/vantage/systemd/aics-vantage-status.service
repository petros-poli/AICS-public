[Unit]
Description=AICS vantage: daily status summary to the phone (ntfy)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A dynamic system user: the probes need no root and no file outside their state.
DynamicUser=yes
User=aics-vantage
# NTFY_TOPIC (secret) and overrides; mode 0600, root, read by systemd before the
# user switch. Written by ops/vantage/install.sh, never in git.
EnvironmentFile=/etc/default/aics-vantage
StateDirectory=aics-vantage
StateDirectoryMode=0700
Environment=AICS_VANTAGE_STATE=/var/lib/aics-vantage
Environment=AICS_LOG_VKEY_FILE=/etc/aics-vantage/log.vkey
Environment=PATH=/opt/wesupport-ai/vantage-venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /opt/wesupport-ai/ops/vantage/vantage-probe.sh status
TimeoutStartSec=5min
UMask=0077
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=256M
