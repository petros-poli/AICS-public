# WeSupport-AI (wesupport-ai.com): production environment for deploy/docker-compose.yml.
#
# Lives on the VPS as /opt/wesupport-ai/deploy/.env: copy this file there, fill it in,
# chmod 600. deploy/deploy-vps.sh refuses to build or start without it and never
# creates it from this example. Never commit a filled-in copy.
# DNS is at Cloudflare; which hostnames it proxies: see docs/DECISIONS.md #10.
#
# No container loads this file whole (no env_file): docker compose reads it to fill the
# ${...} values of docker-compose.yml, and each service receives only the variables its
# environment: list names. The Cloudflare token below reaches caddy only, never aics-server.

# REQUIRED before the first start. The owner's Ed25519 public key (owner login, decision 3):
# base64 of the 32 raw bytes, did:key, or an ssh-ed25519 line. Leaf 0 pins it, together with
# the charter (docker-compose.yml mounts docs/legal/charter.md as published in
# deploy/docs-public), for the life of the log: neither can be added or changed afterwards.
# With AICS_PRODUCTION=1 (set by docker-compose.yml) the server refuses to create the log
# without both.
AICS_OWNER_PUBKEY=

# Pinned in docker-compose.yml; a value set here has no effect:
#   AICS_BASE_URL=https://wesupport-ai.com, AICS_DB_PATH=/data/aics.db, AICS_PRODUCTION=1;
#   AICS_WORKERS=1 (a single writer process is a protocol invariant);
#   AICS_ALLOWED_HOSTS=api.wesupport-ai.com (signed requests without an envelope origin,
#     the owner login among them, are accepted only for this authority);
#   AICS_CHARTER_FILE, AICS_TERMS_FILE, AICS_PRIVACY_FILE (read-only mounts of
#     deploy/docs-public/legal/charter.md, terms.md and retention.md).

# Cloudflare API token for caddy's DNS-01 challenge on the proxied hostnames (Caddyfile:
# dns cloudflare): Zone / Zone / Read and Zone / DNS / Edit, wesupport-ai.com only.
# Only the caddy service receives it.
CLOUDFLARE_API_TOKEN=

# Permanent IndexNow ownership key: generate once with `openssl rand -hex 16`.
# The app serves it publicly at https://wesupport-ai.com/<key>.txt; an empty
# value disables that verification route. See ops/discovery/SEARCH-CONSOLE-SETUP.md.
AICS_INDEXNOW_KEY=

# The reviewed card body, set at runbook step 5 once deploy/card/card-unsigned.json is
# filled (empty: the server serves an unlogged skeleton, never put into a trust bundle):
#   AICS_CARD_FILE=/etc/aics/card/card-unsigned.json
AICS_CARD_FILE=

# Optional limits file under deploy/card/ (empty: the server's DEFAULT_LIMITS). The card
# states the same windows and retention.ciphertext_budget_bytes.
#   AICS_LIMITS_FILE=/etc/aics/card/limits.json
AICS_LIMITS_FILE=

# The text gate's TLS listener on 7700, once Caddy has issued the gate certificate
# (runbook step 4; deploy/gate-tls.yml copies that one certificate for the app):
#   COMPOSE_FILE=docker-compose.yml:gate-tls.yml
# COMPOSE_FILE lists every override in use, separated by ':' (with the pilot override of
# deploy/docker-compose.pilot.yml: docker-compose.yml:docker-compose.pilot.yml:gate-tls.yml).

# Optional 64-hex-character master secret the server derives its signing keys from.
# Prefer leaving it blank: a 32-byte seed is then generated once in
# /data/server_master.seed on the VPS and never leaves it. Back that seed up to
# offline media only, never with the nightly dump (docs/DESIGN.md §10).
AICS_SERVER_SEED_HEX=

# Voluntary contribution addresses. While all of these are EMPTY the contribution
# feature is off: no network is listed. A network is listed only when its variable
# holds an address from the owner's own wallet; the code has no defaults. Decide
# Monero explicitly: some hosting and payment providers' terms exclude it
# (docs/DESIGN.md §7).
AICS_WALLET_BASE_USDC=
AICS_WALLET_SOLANA=
AICS_WALLET_BTC=
AICS_WALLET_XMR=
# The RPC endpoints that check Base and Solana contributions on chain (a listed network
# without one refuses every claim), and the SUP rate (default 100 SUP per USDC); the card's
# sup.contributions must list exactly the networks credited, with the same rate.
AICS_RPC_BASE_URL=
AICS_RPC_SOLANA_URL=
AICS_SUP_PER_USDC=
