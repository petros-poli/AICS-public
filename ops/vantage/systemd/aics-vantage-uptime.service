[Unit]
Description=AICS vantage: uptime, freshness and health probe of api.wesupport-ai.com from the witness host (ntfy alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A dynamic system user: the probes need no root and no file outside their state.
DynamicUser=yes
User=aics-vantage
# NTFY_TOPIC (secret) and overrides; mode 0600, root, read by systemd before the
# user switch. Written by ops/vantage/install.sh, never in git.
EnvironmentFile=/etc/default/aics-vantage
StateDirectory=aics-vantage
StateDirectoryMode=0700
Environment=AICS_VANTAGE_STATE=/var/lib/aics-vantage
Environment=AICS_LOG_VKEY_FILE=/etc/aics-vantage/log.vkey
# Under the card's max_checkpoint_age (300 s), less the 5-minute probe interval's margin; the
# EnvironmentFile above overrides it.
Environment=AICS_CHECKPOINT_MAX_AGE=240
Environment=PATH=/opt/wesupport-ai/vantage-venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /opt/wesupport-ai/ops/vantage/vantage-probe.sh uptime
TimeoutStartSec=4min
UMask=0077
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=256M
