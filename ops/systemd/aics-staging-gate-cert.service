# Copy only test.wesupport-ai.com's certificate from Caddy's store to staging's read-only gate volume
# (deploy/gate-tls-staging.yml). Staging's certificate watcher reloads the copy; this never restarts anything,
# and it never touches production's gate certificate (aics-gate-cert.service does that).
[Unit]
Description=AICS daily staging gate TLS certificate refresh
Documentation=file:///opt/wesupport-ai/ops/RUNBOOK-first-deploy.md
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
ConditionPathExists=/opt/wesupport-ai/deploy/.env
ConditionPathExists=/opt/wesupport-ai/deploy/docker-compose.yml
ConditionPathExists=/opt/wesupport-ai/deploy/gate-tls-staging.yml

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/wesupport-ai/deploy
# Compose reads its own .env. Never source that file into the shell or print the expanded configuration.
# Skipped (not failed) while gate-tls-staging.yml is not in COMPOSE_FILE.
ExecCondition=/bin/sh -c '/usr/bin/docker compose config --services | /usr/bin/grep -qx staging-gate-cert'
ExecStart=/usr/bin/docker compose run --rm staging-gate-cert
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
